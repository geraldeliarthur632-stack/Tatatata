<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Identificação AdMob e Política para Famílias -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANÚNCIO"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#D97706"
                android:background="#FEF3C7"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Google AdMob • Classificação Livre"
                android:textSize="11sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <!-- Status da Tarefa Finalizada -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:background="#ECFDF5"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#059669"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAREFA FINALIZADA"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#059669" />

                <TextView
                    android:id="@+id/tvAdTaskTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quiz de Conhecimentos"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAdXpGain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+50 XP"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#D97706"
                android:background="#FEF3C7"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- Card do Patrocinador Educacional -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0E7FF"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#EEF2FF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECOMENDAÇÃO EDUCACIONAL"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#4F46E5" />

                <TextView
                    android:id="@+id/tvAdSponsorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Olimpíada do Saber &amp; Matemática"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1E1B4B" />

                <TextView
                    android:id="@+id/tvAdSponsorDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Desenvolva seu raciocínio lógico com desafios e simulados gratuitos para todas as séries."
                    android:textSize="12sp"
                    android:textColor="#475569"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botão Continuar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdContinue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="Continuar para o Início"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:backgroundTint="#4F46E5"
            android:textColor="@android:color/white" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
